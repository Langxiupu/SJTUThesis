@inproceedings{xie-routingLEO-CNML2025,
author = {Xie, Qunjun and Shi, Yulin and Gou, Liang},
title = {Centralized Multipath Robust Routing Algorithm for GEO/LEO Satellite Networks},
year = {2025},
isbn = {9798400713231},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
abstract = {To solve the link congestion problem in GEO/LEO satellite networks due to the uneven spatial distribution of service demands and node failures caused by the dynamic satellite environment, a multipath robust routing strategy suitable for GEO/LEO satellite networks is proposed. The strategy comprehensively considers the delay sensitivity of different types of services, the structural characteristics of the satellite network, and the states of links and nodes. Simulation results show that the strategy has significant robustness. Compared to the conventional algorithm, it significantly reduces the average packet loss rate and improves the network throughput under various LEO satellite node failure scenarios. In addition, it ensures strict compliance with low latency requirements for delay-sensitive services and effectively meets the performance requirements of GEO/LEO satellite networks in complex environments.},
booktitle = {Proceedings of the 2025 3rd International Conference on Communication Networks and Machine Learning},
pages = {330–335},
numpages = {6},
keywords = {GEO/LEO, Load Balancing, Multipath Routing, Robust Routing, Satellite Networks},
location = {
},
series = {CNML '25}
}

